{
  "name": "testpilot-ai",
  "version": "0.1.0",
  "private": true,
  "description": "AI-powered Quality Engineering platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:migrate": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f database/migrations/001_initial_schema.sql",
    "db:migrate:versioning": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f database/migrations/002_requirement_versioning.sql",
    "db:migrate:execution": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f database/migrations/003_test_execution_management.sql",
    "db:migrate:cancelled-runs": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f database/migrations/004_cancelled_run_timestamps.sql"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
